{
  "name": "myTradingBox",
  "version": "0.2.13",
  "private": true,
  "scripts": {
    "ng": "ng",
    "set-version": "node ./set-version.js",
    "release-notes:sync": "node ./scripts/generate-release-notes-mock.js",
    "start": "ng serve --host=127.0.0.1",
    "build": "npm run set-version && ng build",
    "build-prod": "npm run set-version && ng build --configuration production --output-hashing=all",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:watch:headless": "ng test --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "e2e": "ng e2e",
    "watch": "ng build --watch --configuration development",
    "deploy": "npm run set-version && node ./scripts/log-deploy.js && npm run release-notes:sync && ng build --configuration production --base-href=/MyTradingBox/ && npx angular-cli-ghpages --dir=dist/MyTradingBox/browser"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/pwa": "^22.1.4",
    "@angular/router": "22.1.2",
    "@angular/service-worker": "22.1.2",
    "@auth0/angular-jwt": "5.2.0",
    "@ng-select/ng-select": "^24.0.1",
    "@ngrx/store": "^22.0.0-rc.0",
    "@ngrx/store-devtools": "^22.0.0-rc.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "buffer": "6.0.3",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-chart-financial": "0.2.1",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "chartjs-plugin-zoom": "2.2.0",
    "date-fns": "^4.4.0",
    "hammerjs": "2.0.8",
    "jwt-decode": "4.0.0",
    "lightweight-charts": "^5.2.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "7.8.2",
    "stream-browserify": "3.0.0",
    "tslib": "2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^22.0.1",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/language-service": "22.1.2",
    "@schematics/angular": "^22.1.4",
    "@types/jasmine": "6.0.0",
    "@types/jasminewd2": "2.0.13",
    "@types/node": "^26.2.0",
    "@types/office-js": "^1.0.605",
    "@types/webpack": "5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "jsdom": "^30.0.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  }
}
