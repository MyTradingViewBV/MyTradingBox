{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "MyTradingBox": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "locales": {
          "en": "src/assets/i18n/en.json"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/MyTradingBox",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              "src/assets",
              "src/manifest.json",
              "src/custom-sw.js"
            ],
            "styles": ["src/styles.scss"],

            "allowedCommonJsDependencies": ["hammerjs"]
          },

          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "32kb"
                }
              ],
              "baseHref": "/MyTradingBox/",
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,

              "serviceWorker": "ngsw-config.json"
            },

            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "aot": true,
              "namedChunks": true,
              "baseHref": "/"
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                { "glob": "**/*", "input": "public" },
                "src/assets",
                "src/manifest.json",
                "src/custom-sw.js"
              ],
              "polyfills": ["zone.js", "zone.js/testing"]
            }
          },

          "defaultConfiguration": "development"
        },

        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "MyTradingBox:build:production"
            },
            "development": {
              "buildTarget": "MyTradingBox:build:development"
            }
          },
          "defaultConfiguration": "development"
        },

        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },

        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "include": ["src/**/*.spec.ts"],
            "watch": false,
            "buildTarget": ":build:testing",
            "runner": "vitest",
            "setupFiles": ["src/testing/test-setup.ts"],
            "coverageReporters": ["text-summary", "html", "lcov"],
            "coverageExclude": ["src/**/*.spec.ts", "src/testing/**"],
            "coverageThresholds": {
              "statements": 45,
              "branches": 30,
              "functions": 47,
              "lines": 46
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
